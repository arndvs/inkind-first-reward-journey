<% content_for(:title) { "Deliveries" } %>

<h1>Deliveries</h1>
<p>Every <code>/users/track</code> body the app has built. In record mode they are stored, not sent.</p>

<table>
  <thead>
    <tr>
      <th>User</th>
      <th>Status</th>
      <th>Attempts</th>
      <th>Created</th>
      <th>Recorded</th>
    </tr>
  </thead>
  <tbody>
    <% @deliveries.each do |delivery| %>
      <tr>
        <td><%= link_to delivery.user.external_id, user_path(delivery.user) %></td>
        <td><%= delivery.status %></td>
        <td><%= delivery.attempts %></td>
        <td><%= delivery.created_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></td>
        <td><%= delivery.recorded_at&.utc&.strftime("%Y-%m-%d %H:%M:%S UTC") || "-" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% @deliveries.each do |delivery| %>
  <%= render "deliveries/delivery", delivery: delivery %>
<% end %>
